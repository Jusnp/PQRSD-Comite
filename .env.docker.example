# Copie este archivo a .env.docker y complete APP_KEY y POSTGRES_PASSWORD
# en la máquina local. .env.docker no se versiona.
# No reutilice la base MariaDB pqrsd_menteplena ni sus credenciales.

APP_NAME="Sistema PQRSD — Comité de Estudios Médicos"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8010
PQRSD_DEV_URL=http://127.0.0.1:8010
PQRSD_ALLOWED_DEV_HOSTS=127.0.0.1,localhost,::1

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO
APP_TIMEZONE=America/Bogota
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Compose fija estos valores dentro de la red Docker.
# PostgreSQL no se publica al anfitrión.
POSTGRES_USER=pqrsd
POSTGRES_PASSWORD=
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=pqrsd_postgres_dev
DB_USERNAME=pqrsd
DB_PASSWORD=

# Usuario distinto al de desarrollo. Solo puede conectarse a pqrsd_postgres_test.
PQRSD_TEST_DB_USERNAME=pqrsd_test
PQRSD_TEST_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PQRSD_META_OPORTUNIDAD=95
PQRSD_SLA_CORREO_ALERTAS=false
PQRSD_MAIL_DRIVER=mock
GMAIL_SERVICE_ACCOUNT_ENABLED=false

POLITICA_SITIO_URL=https://comitedeestudiosmedicos.com.co/
POLITICA_TRATAMIENTO_URL=https://comitedeestudiosmedicos.com.co/wp-content/uploads/2026/08/PO-GJ-JUR-001-Politica-para-el-tratamiento-de-datos-personales-V01-1-1.pdf
POLITICA_TRATAMIENTO_VERSION=01
POLITICA_TRATAMIENTO_CODIGO=PO-GJ-JUR-001
POLITICA_TRATAMIENTO_FECHA=01/08/2026

# Vacío: no se crean claves de laboratorio dentro de la imagen.
PQRSD_LAB_PASSWORD=

# Misma puerta OIDC ya registrada para el puerto 8010.
# Copie los valores desde el .env local. No los versiona este archivo.
# No registre otra URI ni cree otro cliente en Authentik.
AUTHENTIK_ENABLED=true
AUTHENTIK_LOCAL_LOGIN_ENABLED=false
# Compose vuelve a fijar este valor en false para que el ingreso no escriba en Authentik.
AUTHENTIK_PROVISIONING_ENABLED=false
AUTHENTIK_BASE_URL=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://127.0.0.1:8010/auth/authentik/callback
AUTHENTIK_API_TOKEN=
