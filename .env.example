APP_NAME="Sistema PQRSD — Comité de Estudios Médicos"
# Identidad visible (opcional; por defecto usa config/identidad.php)
#IDENTIDAD_NOMBRE="Comité de Estudios Médicos"
#IDENTIDAD_SISTEMA="Sistema PQRSD — Comité de Estudios Médicos"
#IDENTIDAD_CORTO="Comité de Estudios Médicos"
#IDENTIDAD_LOGO=images/logo-comite-estudios-medicos.png
#IDENTIDAD_LOGO_HEADER=images/logo-comite-estudios-medicos.png
#IDENTIDAD_LOGO_COMPACTO=images/logo-comite-estudios-medicos.png
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010
# Puerto de `php artisan serve` y de `php artisan dev` (no usar 8000).
SERVER_HOST=127.0.0.1
SERVER_PORT=8010

# URL del formulario/QR en desarrollo (host/puerto reales del servidor local).
# Debe coincidir con `php artisan serve` (p. ej. http://127.0.0.1:8010).
# Para probar desde un celular en la misma red: IP LAN verificada + puerto, y agréguela a PQRSD_ALLOWED_DEV_HOSTS.
PQRSD_DEV_URL=http://127.0.0.1:8010
PQRSD_ALLOWED_DEV_HOSTS=127.0.0.1,localhost,::1

# URL pública definitiva (producción, HTTPS institucional). Tiene prioridad sobre APP_URL/DEV_URL.
# No imprima QR con localhost, 127.0.0.1 o dominios .test/.local.
#PQRSD_PUBLIC_URL=https://pqrsd.ejemplo.org
#PQRSD_PUBLICO_MAX_FILES=5
#PQRSD_PUBLICO_MAX_KB=10240

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO
APP_TIMEZONE=America/Bogota

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pqrsd_menteplena
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Meta institucional de oportunidad de respuesta PQRSD (%)
PQRSD_META_OPORTUNIDAD=95

# Contraseña solo para cuentas de laboratorio @menteplena.test.
# Déjela vacía fuera de su máquina local. No la use en producción.
PQRSD_LAB_PASSWORD=

# Authentik SSO + aprovisionamiento (ver docs/usuarios-pqrsd-aprovisionamiento-authentik.md)
#AUTHENTIK_ENABLED=false
#AUTHENTIK_LOCAL_LOGIN_ENABLED=true
#AUTHENTIK_PROVISIONING_ENABLED=false
#AUTHENTIK_BASE_URL=https://auth.ejemplo.org
#AUTHENTIK_CLIENT_ID=
#AUTHENTIK_CLIENT_SECRET=
#AUTHENTIK_REDIRECT_URI="${APP_URL}/auth/authentik/callback"
#AUTHENTIK_API_TOKEN=
#AUTHENTIK_APP_SLUG=pqrsd-comite
#AUTHENTIK_GROUP_NAME=pqrsd-usuarios
#AUTHENTIK_ENROLLMENT_FLOW_SLUG=pqrsd-invitation-enrollment
#AUTHENTIK_ENROLLMENT_FLOW_PK=
#AUTHENTIK_INVITATION_TTL_HOURS=48
#AUTHENTIK_EMAIL_CONFIGURED=

