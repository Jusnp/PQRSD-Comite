# Copie este archivo a .env.production en el servidor.
# .env.production no se versiona. No pegue secretos en Git ni en la imagen.
# Genere APP_KEY una sola vez en el servidor y no la regenere si ya hay datos cifrados.

APP_NAME="Sistema PQRSD — Comité de Estudios Médicos"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pqrsd.comitedeestudiosmedicos.com.co
APP_TIMEZONE=America/Bogota
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

LOG_CHANNEL=stack
LOG_LEVEL=warning

# PostgreSQL nuevo. No use la base MariaDB ni las claves del entorno local.
POSTGRES_DB=pqrsd_prod
POSTGRES_USER=pqrsd_owner
POSTGRES_PASSWORD=
PQRSD_APP_DB_PASSWORD=
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=pqrsd_prod
DB_USERNAME=pqrsd_app
DB_PASSWORD=

# Solo loopback. 8080 lo usa SISPAM; no lo reutilice.
PQRSD_HTTP_PORT=8081
PQRSD_IMAGE_TAG=local
# CIDR del proxy que puede informar la IP del cliente. No use * ni 0.0.0.0/0.
PQRSD_TRUSTED_PROXY_CIDR=127.0.0.1
# IP o CIDR que Laravel puede tratar como proxy. Vacio hasta conocer el proxy.
TRUSTED_PROXIES=
# Hosts adicionales, separados por comas. APP_URL y PQRSD_PUBLIC_URL ya cuentan.
TRUSTED_HOSTS=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=120
CACHE_STORE=database

# Correo y Gmail permanecen apagados en este despliegue.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
PQRSD_MAIL_DRIVER=mock
PQRSD_SLA_CORREO_ALERTAS=false
GMAIL_SERVICE_ACCOUNT_ENABLED=false
GMAIL_PUBSUB_SKIP_OIDC=false
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=https://pqrsd.comitedeestudiosmedicos.com.co/oauth/gmail/callback
GMAIL_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.modify
GMAIL_ALLOWED_MAILBOXES=
GMAIL_PILOT_MAILBOX=

FILESYSTEM_DISK=local

# URL publica del formulario y del QR. Debe ser HTTPS y coincidir con APP_URL
# salvo que el ciudadano use otro nombre ya autorizado.
PQRSD_PUBLIC_URL=https://pqrsd.comitedeestudiosmedicos.com.co

POLITICA_SITIO_URL=https://comitedeestudiosmedicos.com.co/
POLITICA_TRATAMIENTO_URL=https://comitedeestudiosmedicos.com.co/wp-content/uploads/2026/08/PO-GJ-JUR-001-Politica-para-el-tratamiento-de-datos-personales-V01-1-1.pdf
POLITICA_TRATAMIENTO_VERSION=01
POLITICA_TRATAMIENTO_CODIGO=PO-GJ-JUR-001
POLITICA_TRATAMIENTO_FECHA=01/08/2026

# OIDC. El aprovisionamiento queda apagado: Compose tambien lo fuerza en false.
# La URI debe registrarse despues en Authentik. No la active en esta fase.
AUTHENTIK_ENABLED=true
AUTHENTIK_LOCAL_LOGIN_ENABLED=false
AUTHENTIK_PROVISIONING_ENABLED=false
AUTHENTIK_BASE_URL=https://auth.comitedeestudiosmedicos.com.co
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=https://pqrsd.comitedeestudiosmedicos.com.co/auth/authentik/callback
AUTHENTIK_API_TOKEN=
AUTHENTIK_APP_SLUG=pqrsd-comite
AUTHENTIK_GROUP_NAME=pqrsd-usuarios
AUTHENTIK_ENROLLMENT_FLOW_SLUG=pqrsd-invitation-enrollment

PQRSD_BACKUP_RETENTION_DAYS=30
PQRSD_BACKUP_ENCRYPT=false
PQRSD_BACKUP_ENCRYPTION_KEY=
PQRSD_BACKUP_EXTERNAL_DRIVER=null
PQRSD_META_OPORTUNIDAD=95
PQRSD_SUSPENDER_RADICACION=false
