APP_NAME="Sistema PQRSD — Comité de Estudios Médicos"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pqrsd.menteplena.com.co
APP_TIMEZONE=America/Bogota
APP_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pqrsd_menteplena
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=120
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@menteplena.com.co
MAIL_FROM_NAME="${APP_NAME}"

# Integración PQRSD correo (Google Workspace / Gmail API)
PQRSD_MAIL_DRIVER=google_api
PQRSD_MAIL_CENTRAL=pqrsd@menteplena.com.co
PQRSD_MAIL_SYNC_MINUTES=5
PQRSD_MAIL_ATTACHMENTS_DISK=local

# Piloto: una sola cuenta real autorizada. No conectar todos los buzones.
GMAIL_PILOT_MAILBOX=piloto-pqrsd@menteplena.com.co
GMAIL_ALLOWED_MAILBOXES=piloto-pqrsd@menteplena.com.co
GMAIL_PUBSUB_TOPIC=projects/PROYECTO/topics/gmail-pqrsd
GMAIL_PUBSUB_PUSH_AUDIENCE="${APP_URL}/webhooks/gmail-pubsub"
GMAIL_PUBSUB_SERVICE_ACCOUNT=gmail-pubsub@PROYECTO.iam.gserviceaccount.com
GMAIL_PUBSUB_SKIP_OIDC=false
GMAIL_SERVICE_ACCOUNT_ENABLED=false
GMAIL_RECONCILE_QUERY=newer_than:7d

# OAuth 2.0 (preferido; menor privilegio que Domain-Wide Delegation)
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI="${APP_URL}/oauth/gmail/callback"
GMAIL_OAUTH_SCOPES="https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.send"

# credential_ref opcional (además de OAuth cifrado en BD)
MAIL_CRED_PQRSD=

SESSION_SECURE_COOKIE=true

PQRSD_BACKUP_RETENTION_DAYS=30
PQRSD_BACKUP_ENCRYPT=true
PQRSD_BACKUP_ENCRYPTION_KEY=
PQRSD_BACKUP_EXTERNAL_DRIVER=s3
PQRSD_BACKUP_EXTERNAL_DISK=s3
PQRSD_BACKUP_EXTERNAL_PREFIX=pqrsd-backups/
# RPO/RTO: definir con SSI; no inventar
PQRSD_RPO_HOURS=
PQRSD_RTO_HOURS=

PQRSD_WORKER_HEARTBEAT_MAX=120
PQRSD_OLDEST_JOB_ALERT=900

FILESYSTEM_DISK=local

# Meta institucional (solo cambiar con aprobaci�n)
PQRSD_META_OPORTUNIDAD=95
