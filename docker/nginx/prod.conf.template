server {
    listen 80;
    server_name _;
    server_tokens off;
    root /var/www/html/public;
    index index.php;
    client_max_body_size 12m;
    absolute_redirect off;
    port_in_redirect off;

    # Solo la dirección indicada puede aportar la IP del cliente.
    # El valor * o 0.0.0.0/0 no debe usarse. HTTPS lo fija este servidor,
    # no el encabezado que envíe el navegador.
    set_real_ip_from ${PQRSD_TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive off;

    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_pass app:9000;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT /var/www/html/public;
        fastcgi_param HTTPS on;
        fastcgi_param HTTP_X_FORWARDED_PROTO https;
        fastcgi_param HTTP_X_FORWARDED_PORT 443;
        fastcgi_param SERVER_PORT 443;
        fastcgi_hide_header X-Powered-By;
        fastcgi_read_timeout 120s;
    }

    location ~ /\.env {
        deny all;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
